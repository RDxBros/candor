# Either the project URL or its /rest/v1 endpoint is accepted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Optional server-only deployment controls.
CURRENT_DAY=day1
ALLOW_DAY_OVERRIDE=0
NOINDEX=1

# Generation scripts only. Do not add this to Vercel unless generation runs there.
GEMINI_API_KEY=your-generation-only-key
GEMINI_MODEL=gemini-3.8-flash

# Web Push. Generate once with: npx web-push generate-vapid-keys --json
# The public key is intentionally bundled into browser JavaScript.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-url-safe-public-vapid-key
# Server only. Keep the same key pair for the lifetime of existing subscriptions.
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=generate-a-long-random-secret
